<odoo>
    <data>
        <record model="ir.ui.view" id="finalize_contributions_tree_id">
            <field name="name">finalize.contributions.tree</field>
            <field name="model">finalize.contributions</field>
            <field name="arch" type="xml">
                <tree create="0">
                    <header>
<!--                        <button name="import_payroll" string="Conciliar" class="oe_highlight" type="object"/>-->
<!--                        <button name="assign_performance" string="Asignar rendimiento" type="object"-->
<!--                                class="oe_highlight"-->
<!--                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"-->
<!--                        />-->
                    </header>
                    <field name="name" />
                    <field name="partner_payroll_ids" readonly="1"/>
                    <field name="disengagement"/>
                    <field name="total_mandatory_contributions"/>
                    <field name="total_voluntary_contributions"/>
                    <field name="total_capital_initial"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="finalize_contributions_form_id">
            <field name="name">finalize.contributions.form</field>
            <field name="model">finalize.contributions</field>
            <field name="arch" type="xml">
                <form string="Solicitud de presupuesto" class="oe_left oe_edit_only oe_form_required" create="0">
                    <header>
<!--                        <button name="exclude_contributions" string="No asociado"-->
<!--                                type="object"-->
<!--                                class="oe_close_button"-->
<!--                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"-->
<!--                                attrs="{'invisible': [('state', '!=', 'process')]}"/>-->
<!--                        <field name="state" widget="statusbar"/>-->
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" string="Nombre"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Aportes">
                                <field name="name" />
                                <field name="partner_payroll_ids" readonly="1"/>
                                <field name="disengagement"/>
                                <field name="total_mandatory_contributions"/>
                                <field name="total_voluntary_contributions"/>
                                <field name="total_capital_initial"/>
                            </group>
                            <group>

                            </group>
                        </group>
                        <group>
                            <group string="Prestamo">
                                <field name="loan_capital_bolivianos"/>
                                <field name="balance_interest_month_bolivianos"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Contabilidad">
                                <group>
                                    <group string="Debe">
                                        <field name="account_voluntary_contributions"/>
                                        <field name="total_voluntary"/>
                                    </group>
                                    <group string="Haber">
                                        <field name="account_capital_loan"/>
                                        <field name="total_capital_initial"/>
                                        <field name="account_capital_loan"/>
                                        <field name="loan_capital_bolivianos" readonly="1"/>
                                        <field name="account_interest_month"/>
                                        <field name="balance_interest_month_bolivianos" readonly="1"/>
                                    </group>

                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>


    </data>
</odoo>
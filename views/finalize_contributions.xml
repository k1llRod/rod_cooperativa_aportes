<odoo>
    <data>
        <record model="ir.ui.view" id="finalize_contributions_tree_id">
            <field name="name">finalize.contributions.tree</field>
            <field name="model">finalize.contributions</field>
            <field name="arch" type="xml">
                <tree create="0">
                    <header>
                        <button name="action_confirm" string="Confirmar" class="oe_highlight" type="object"/>
<!--                        <button name="assign_performance" string="Asignar rendimiento" type="object"-->
<!--                                class="oe_highlight"-->
<!--                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"-->
<!--                        />-->
                    </header>
                    <field name="name" />
                    <field name="partner_payroll_ids" readonly="1"/>
                    <field name="disengagement"/>
                    <field name="total_mandatory_contributions"/>
                    <field name="total_voluntary_contributions"/>
                    <field name="total_capital_initial"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="finalize_contributions_form_id">
            <field name="name">finalize.contributions.form</field>
            <field name="model">finalize.contributions</field>
            <field name="arch" type="xml">
                <form string="Solicitud de presupuesto" class="oe_left oe_edit_only oe_form_required" create="0">
                    <header>
                        <button name="action_confirm" string="Confirmar"
                                type="object"
                                class="oe_close_button"
                                />
<!--                        <button name="exclude_contributions" string="No asociado"-->
<!--                                type="object"-->
<!--                                class="oe_close_button"-->
<!--                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"-->
<!--                                attrs="{'invisible': [('state', '!=', 'process')]}"/>-->
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" string="Nombre"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Aportes">
                                <field name="liquidation_contributions" invisible="1"/>
                                <field name="name" readonly="1"/>
                                <field name="date_proccess"/>
                                <field name="partner_payroll_ids" readonly="1"/>
                                <field name="disengagement"/>
                                <field name="regulation_cup"/>
                                <field name="total_mandatory_contributions"/>
                                <field name="total_voluntary_contributions"/>
                                <field name="total_capital_initial"/>
                                <field name="other_contributions"/>
                                <field name="surpluses"/>
                                <field name="perfomance_contributions"/>
                                <field name="total_partial_devolution"/>
                            </group>
                            <group>

                            </group>
                        </group>
                        <group>
                            <group string="Prestamo">
                                <field name="liquidation" invisible="1"/>
                                <field name="loan_application_ids"/>
                                <field name="loan_capital_bolivianos"/>
                                <field name="balance_interest_month_bolivianos"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Contabilidad">
                                <group>
                                    <group>
                                        <field name="journal_id"/>
                                    </group>
                                    <group>
                                        <field name="account_move_id"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Debe">
                                        <field name="account_voluntary_contributions"/>
                                        <field name="discount_contribution"/>
                                        <field name="total_voluntary"/>
                                        <field name="account_mandatory_contributions"/>
                                        <field name="total_mandatory_contributions"/>
                                        <field name="account_other_contributions"/>
                                        <field name="other_contributions"/>
                                        <field name="account_surpluses"/>
                                        <field name="surpluses"/>
                                        <field name="account_performance_contributions"/>
                                        <field name="perfomance_contributions"/>
                                        <field name="total_amount"/>
                                    </group>
                                    <group string="Haber">
                                        <field name="account_capital_loan"/>
                                        <field name="loan_capital_bolivianos"/>
                                        <field name="account_interest_month"/>
                                        <field name="balance_interest_month_bolivianos"/>
                                        <field name="account_bank_rest"/>
                                        <field name="total_diference_contribution_loan"/>

                                        <h3 style="color:blue;">Cuentas Aportes</h3>
                                        <field name="account_disengagement"/>
                                        <field name="disengagement"/>
                                        <field name="account_regulation_cup"/>
                                        <field name="manual_regulation_cup"/>
                                        <field name="account_bank_rest_contributions"/>
                                        <field name="rest_contributions"/>
                                        <field name="total_amount_credit"/>
                                    </group>

                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>


    </data>
</odoo>
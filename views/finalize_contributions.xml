<odoo>
    <data>
        <!-- Vista Árbol de Modelo partner payroll -->

        <record model="ir.ui.view" id="finalize_contributions_tree_id">
            <field name="name">finalize.contributions.tree</field>
            <field name="model">finalize.contributions</field>
            <field name="arch" type="xml">
                <tree create="0">
                    <field name="name"/>
                    <field name="date_finalize" />
                    <field name="disengagement"/>
                    <field name="total_mandatory_contributions_certificate"/>
                    <field name="total_voluntary_contributions_certificate"/>
                    <field name="total_other_contributions"/>
                    <field name="total_surpluses"/>
                    <field name="total_performance_contributions"/>
<!--                    <field name="total_loan_capital"/>-->
<!--                    <field name="total_loan_capital_bolivianos" optional="hidden"/>-->
<!--                    <field name="total_balance_total_interest_month"/>-->
<!--                    <field name="total_balance_total_interest_month_bolivianos" optional="hidden"/>-->
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="finalize_contributions_form">
            <field name="name">finalize.contributions.form</field>
            <field name="model">finalize.contributions</field>
            <field name="arch" type="xml">
                <form string="Liquidacion de aportes">
                    <header>
                        <button name="action_confirm" string="Confirmar" class="oe_highlight" type="object"/>
                        <button name="action_draft" string="Borrador" type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group string="Liquidacion de aportes">
                            <group>
                                <div class="oe_title">
                                    <h1>
                                        <field name="name" string="Nombre" readonly="1"/>
                                    </h1>
                                </div>
                                <field name="partner_payroll_id" readonly="1"/>
                                <field name="date_finalize"/>
                                <field name="disengagement"/>
                                <field name="total_mandatory_contributions_certificate"/>
                                <field name="total_voluntary_contributions_certificate"/>
                                <field name="total_other_contributions"/>
                                <field name="total_surpluses"/>
                                <field name="total_performance_contributions"/>
                            </group>
                            <group>
<!--                                <field name="partner_status_reafiliation"/>-->
                                <field name="reafiliation"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Contabilidad">
                                <header>
                                    <field name="accounting_finalize_contributions_state" widget="statusbar"/>
                                </header>
                                <group string="Contabilidad">
                                    <group>
                                        <field name="journal_id"/>
                                    </group>
                                    <group>
                                        <field name="accounting_finalize_contributions_id" readonly="1"/>
                                    </group>
                                </group>
<!--                                <group>-->
<!--                                    <group string="Debe">-->
<!--                                        <field name="account_loan_id"/>-->
<!--                                        <field name="amount_account_loan"/>-->
<!--                                    </group>-->
<!--                                    <group string="Haber">-->
<!--                                        <field name="account_regular_loan_amortization"/>-->
<!--                                        <field name="amount_regular_loan_amortization"/>-->
<!--                                        <field name="account_other_income"/>-->
<!--                                        <field name="amount_other_income"/>-->
<!--                                        <field name="total_payment_bolivianos"/>-->
<!--                                    </group>-->
<!--                                </group>-->
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Accion para visualizar loan.application -->

        <record id="action_finalize_contributions" model="ir.actions.act_window">
            <field name="name">Baja asociado</field>
            <field name="res_model">finalize.contributions</field>
            <field name="view_mode">tree,form,pivot</field>
        </record>

    </data>
</odoo>
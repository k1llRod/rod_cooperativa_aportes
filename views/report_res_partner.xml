<odoo>
    <data>
        <record id="view_partner_payroll_tree_custom" model="ir.ui.view">
            <field name="name">partner.payroll.tree.custom</field>
            <field name="model">partner.payroll</field>
            <field name="arch" type="xml">
                <tree string="Socios que solicitaron su desvinculacion">
                    <field name="category_partner"/>
                    <field name="partner_id"/>
                    <field name="code_contact"/>
                    <field name="vat"/>
                    <field name="partner_state"/>
                    <field name="capital_initial"/>
                    <field name="partner_status_especific"/>
                    <field name="date_registration" optional="hide"/>
                    <field name="date_burn_partner" optional="hide"/>
                    <field name="advanced_payments" optional="hide"/>
                    <field name="count_pay_contributions" optional="hide"/>
<!--                    <field name="outstanding_payments" optional="hide"/>-->
                    <field name="outstanding"/>
                    <field name="voluntary_contribution_certificate_total" optional="hide"/>
                    <field name="mandatory_contribution_certificate_total" optional="hide"/>
                    <field name="performance_management_total"/>
                    <field name="contribution_total"/>
                    <field name="state" decoration-info="state == 'draft'" decoration-success="state == 'progress'" widget="badge"/>
                </tree>
            </field>
        </record>
        <record id="action_partner_payroll_custom" model="ir.actions.act_window">
            <field name="name">Reporte de socios que solicitaron su desvinculacion</field>
            <field name="res_model">partner.payroll</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type_disengagements', '=', 'retiro_voluntario')]</field>
            <field name="help">Este reporte muestra a los socios que solicitaron su desvinculacion.</field>
            <field name="view_id" ref="view_partner_payroll_tree_custom"/>
        </record>
        <record id="view_partner_payroll_tree_custom_a_b" model="ir.ui.view">
            <field name="name">partner.payroll.tree.custom</field>
            <field name="model">partner.payroll</field>
            <field name="arch" type="xml">
                <tree string="Socios que solicitaron su desvinculacion">
                    <field name="category_partner"/>
                    <field name="partner_id"/>
                    <field name="mandatory_contribution_certificate_total"/>
                    <field name="voluntary_contribution_certificate_total"/>
                    <field name="other_contribution_total"/>
                    <field name="surpluses_total"/>
                    <field name="contribution_total"/>
                    <field name="state" optional="hidden"/>
                </tree>
            </field>
        </record>
        <record id="view_res_partner_tree_baja" model="ir.ui.view">
            <field name="name">res.partner.tree.baja</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <tree string="Socios dados de baja" create="false">
                    <header>
                        <button name="print_report_unsubscribe"
                                type="object"
                                string="Exportar PDF"
                                class="btn btn-primary"
                                icon="fa-print"
                                context="{'active_ids': active_ids}"/>
                    </header>
                    <field name="date_disengagements"/>
                    <field name="name"/>
                    <field name="vat"/>
                    <field name="street"/>
                    <field name="type_disengagements"/>
                    <field name="gloss_disengagement"/>
                </tree>
            </field>
        </record>
        <record id="action_partner_payroll_custom_total_a" model="ir.actions.act_window">
            <field name="name">Reporte de socios categoria A</field>
            <field name="res_model">partner.payroll</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('partner_status_especific', '=', 'passive_reserve_a'),('state','=','process')]</field>
            <field name="help">Este reporte muestra a los socios con aportes de la categoria A.</field>
            <field name="view_id" ref="view_partner_payroll_tree_custom_a_b"/>
        </record>
        <record id="action_partner_payroll_custom_total_b" model="ir.actions.act_window">
            <field name="name">Reporte de socios categoria B</field>
            <field name="res_model">partner.payroll</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('partner_status_especific', '=', 'passive_reserve_b'),('state','=','process')]</field>
            <field name="help">Este reporte muestra a los socios con aportes de la categoria B.</field>
            <field name="view_id" ref="view_partner_payroll_tree_custom_a_b"/>
        </record>
        <record id="action_res_partner_tree_baja" model="ir.actions.act_window">
            <field name="name">Reporte de socios dados de baja</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'unsubscribe')]</field>
            <field name="context">{'search_default_group_type_disengagements': 1}</field>
            <field name="help">Este reporte muestra a los socios dados de baja.</field>
            <field name="view_id" ref="view_res_partner_tree_baja"/>
        </record>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="res_partner_form_inh_aportes">
            <field name="name">res.partner.form.inh.aportes</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="rod_cooperativa.res_partner_form_inh"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="before">
                    <widget name="web_ribbon" text="Activo" attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <widget name="web_ribbon" text="Baja" bg_color="bg-danger" attrs="{'invisible': [('state', '!=', 'unsubscribe')]}"/>
                </xpath>
                <xpath expr="//sheet" position="before">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,verificate,activate"/>
                        <button name="init_partner" string="Iniciar aportes" type="object"
                                attrs="{'invisible': ['|',('state', '!=', 'verificate'),('contributions_count','>','0')]}"/>
                        <button name="init_loan" string="Iniciar prestamo" type="object"
                                attrs="{'invisible': ['|',('state', '!=', 'activate'),('loan_count','>','0')]}"/>
                        <button name="init_loan_mortgage" string="Iniciar prestamo hipotecario" type="object"
                                attrs="{'invisible': ['|',('state', '!=', 'activate'),('loan_count_mortgage','>','0')]}"/>
                        <button name="init_loan_emergency" string="Iniciar prestamo emergencia" type="object"
                                attrs="{'invisible': [('state','!=','activate'),('state','!=','external')]}"
                                />
<!--                        <button name="init_loan_emergency" string="Iniciar prestamo de emergencia" type="object"-->
<!--                                />-->
                        <button name="approve_verification" string="Verificar" type="object"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="approve_partner" string="Aprobar socio" type="object"
                                class="oe_highlight" attrs="{'invisible': [('state', '!=', 'verificate')]}"/>
                        <button name="return_form" string="Solicitud rechazada" type="object"
                                attrs="{'invisible': [('state', '!=', 'verificate')]}"/>
<!--                        <button name="unsubscribe" string="Dar de baja" type="object"-->
<!--                                confirm="¿Está seguro que desea dar de baja al asociado?"-->
<!--                        />-->
                        <button name="form_unsubscribe" string="Dar de baja" type="object"
                        />
                        <button name="action_generate_birthday_card"
                                string="Generar Tarjeta Cumpleaños"
                                type="object"
                                class="oe_highlight"
                                icon="fa-birthday-cake"/>
                    </header>

                </xpath>
                <xpath expr="//button[@name='action_view_guarantor']" position="after">
                    <button type="object" icon="fa-user" class="oe_stat_button" name="action_view_contributions">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="contributions_count"/>
                            </span>
                            <span class="o_stat_text">Aportes</span>
                        </div>
                    </button>
                    <button type="object" icon="fa-user" class="oe_stat_button" name="action_view_loans">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="loan_count"/>
                            </span>
                            <span class="o_stat_text">Préstamos</span>
                        </div>
                    </button>
                    <button type="object" icon="fa-user" class="oe_stat_button" name="action_view_loans_mortgage">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="loan_count_mortgage"/>
                            </span>
                            <span class="o_stat_text">Préstamos hipotecarios</span>
                        </div>
                    </button>
                    <button type="object" icon="fa-user" class="oe_stat_button" name="action_view_loans_emergency">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="loan_count_loan_emergency"/>
                            </span>
                            <span class="o_stat_text">Préstamos emergencia</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//sheet/notebook/page[1]" position="after">
                    <page string="Post Mortem" >
                        <group>
                            <group string="Datos bases">
                                <field name="partner_payroll_ids"/>
                                <field name="loan_application_ids"/>
                                <field name="base_amount"/>
                                <field name="base_longevity"/>
                                <field name="global_amount"/>
                                <button name="registry_payment_post_mortem" class="oe_highlight" string="Registrar pago"
                                        type="object"/>
                            </group>
                            <group string="Saldos">
                                <field name="balance_post_mortem"/>
                                <field name="balance_longevity"/>
                                <field name="since"/>
                                <field name="until"/>

<!--                                <field name="Saldo post mortem"/>-->
                            </group>
                        </group>
                        <field name="post_mortem_ids" context="{'form_view_ref': 'rod_cooperativa.post_mortem_form_id'}">
                            <tree string="Pagos" create="0" >
                                <field name="name"/>
                                <field name="family_ids" widget="many2many_tags"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="type_payment"/>
                                <field name="payment_date"/>
                                <field name="return_amount"/>
                                <field name="observation"/>
                                <field name="state"
                                       widget="badge"
                                       decoration-info="state == 'draft'"
                                       decoration-warning="state == 'verification'"
                                       decoration-success="state == 'paid'"
                                />
                                <button name="get_formview_action" type="object" icon="fa-external-link" title="Abrir Formulario Completo"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
<!--                <xpath expr="//field[@name='name']" position="after">-->
<!--                    <field name="loan_count_mortgage" />-->
<!--                </xpath>-->
            </field>
        </record>

<!--        <record model="ir.ui.view" id="res_partner_tree_inh_aportes">-->
<!--            <field name="name">res.partner.tree.inh.aportes</field>-->
<!--            <field name="model">res.partner</field>-->
<!--            <field name="inherit_id" ref="rod_cooperativa.res_partner_tree_inh"/>-->
<!--            <field name="arch" type="xml">-->

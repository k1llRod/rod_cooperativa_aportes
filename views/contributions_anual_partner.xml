<odoo>
    <record id="view_contributions_anual_partner_tree" model="ir.ui.view">
        <field name="name">contributions.anual.partner.tree</field>
        <field name="model">contributions.anual.partner</field>
        <field name="arch" type="xml">
            <tree default_order="partner_id asc">
                <field name="batch_id"/>
                <!--                            <field name="name"/>-->
                <!--                            <field name="date_init"/>-->
                <field name="date_burn_partner"/>
                <field name="year"/>
                <field name="partner_payroll_ids" optional="hidden"/>
                <field name="partner_id"/>
                <field name="partner_status_especific"/>
                <field name="total_mandatory_contribution"/>
                <field name="total_voluntary_contribution"/>
                <field name="total_contribution"/>
                <field name="payroll_count"/>
                <field name="factor"/>
                <field name="amount_factor_calculate_yield"/>
            </tree>
        </field>
    </record>


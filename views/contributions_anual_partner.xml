                    <group>
                        <group string="Aportes">
                            <field name="batch_id"/>
<!--                            <field name="name"/>-->
<!--                            <field name="date_init"/>-->
                            <field name="date_burn_partner"/>
                            <field name="year"/>
                            <field name="partner_payroll_ids"/>
                            <field name="partner_id"/>
                            <field name="partner_status_especific"/>
                            <field name="total_mandatory_contribution"/>

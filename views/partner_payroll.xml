<odoo>
    <data>
        <!-- Vista Árbol de Modelo partner payroll -->

        <record model="ir.ui.view" id="partner_payroll_tree_id">
            <field name="name">partner.payroll.tree</field>
            <field name="model">partner.payroll</field>
            <field name="arch" type="xml">
                <tree create="0" js_class="partner_payroll_dashboard_list">
                    <header>
                        <button name="import_payroll" string="Conciliar" class="oe_highlight" type="object"/>
                        <button name="assign_performance" string="Asignar rendimiento" type="object"
                                class="oe_highlight"
                        />
                    </header>
                    <field name="name" optional="hide"/>
                    <field name="city" optional="hide"/>
                    <field name="partner_id"/>
                    <field name="code_contact"/>
                    <field name="vat"/>
                    <field name="partner_state"/>
                    <field name="capital_initial"/>
                    <field name="partner_status_especific"/>
                    <field name="date_registration" optional="show"/>
                    <field name="date_burn_partner" optional="show"/>
                    <field name="advanced_payments" optional="show"/>
                    <field name="count_pay_contributions" optional="show"/>
<!--                    <field name="outstanding_payments" optional="hide"/>-->
                    <field name="outstanding"/>
                    <field name="voluntary_contribution_certificate_total" optional="show"/>
                    <field name="mandatory_contribution_certificate_total" optional="show"/>
<!--                    <field name="performance_management_total"/>-->
                    <field name="contribution_total"/>
                    <field name="state" decoration-info="state == 'draft'" decoration-success="state == 'progress'"
                           widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Vista Formulario loan.application  -->

        <record model="ir.ui.view" id="partner_payroll_form_id">
            <field name="name">partner.payroll.form</field>
            <field name="model">partner.payroll</field>
            <field name="arch" type="xml">
                <form string="Solicitud de presupuesto" class="oe_left oe_edit_only oe_form_required" create="0">
                    <header>
                        <button name="init_payroll_partner_wizard" string="Establecer capital inicial" type="object"
                                class="oe_close_button"
                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"
                                attrs="{'invisible': ['|',('state', '!=', 'draft'),('partner_status_especific','!=','passive_reserve_a')]}"/>
                        <!--                        <button name="wizard_pay_contribution" string="Registrar pago" type="object"-->
                        <!--                                class="oe_close_button"-->
                        <!--                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"-->
                        <!--                                attrs="{'invisible': [('state', '!=', 'process'),('partner_status_especific','!=','passive_reserve_a')]}" />-->
                        <!--                        <button name="print_report_total" string="Imprimir planilla total" type="object"-->
                        <!--                                class="oe_highlight"/>-->
                        <button name="return_draft" string="Borrador" type="object"
                                class="oe_close_button"
                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator" />
<!--                                attrs="{'invisible': ['|',('state', '!=', 'process'),('state','!=','finalized')]}"/>-->
<!--                        <button name="init_partner_payroll_interest" string="Establecer interes" type="object"-->
<!--                                class="oe_highlight"-->
<!--                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"-->
<!--                        />-->
                        <button name="resume_process" string="Retomar proceso" type="object"
                                class="oe_close_button"
                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"
                                attrs="{'invisible': [('state', '!=', 'draft'),('date_burn_partner','!=',False)]}"/>



                        <button name="wizard_payroll_return" string="Devolucion aportes" type="object"
                                class="oe_highlight"
                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"
                                attrs="{'invisible': [('state', '!=', 'process')]}"
                        />
                        <button name="finalized_payroll" string="Liquidación"
                                type="object"
                                class="oe_close_button"
                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"
                                attrs="{'invisible': [('state', '!=', 'process')]}"/>
                        <button name="exclude_contributions" string="No asociado"
                                type="object"
                                class="oe_close_button"
                                groups="rod_cooperativa_aportes.group_rod_cooperativa_aportes_operator"
                                attrs="{'invisible': [('state', '!=', 'process')]}"/>

                        <!--                        <button name="payment_advance" string="Pagos adelantados" type="object"-->
                        <!--                                />-->
<!--                        <button name="validate_partner_passive" string="Validar asociado" type="object"/>-->

                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" text="Liquidado" attrs="{'invisible': [('state','!=','finalized')]}"/>
                        <div class="alert alert-warning text-center o_form_header" role="alert"
                             attrs="{'invisible': [('outstanding','=',0)]}">
                            <a class="close" data-dismiss="alert" href="#">x</a>
                            <div>
                                <strong>Planilla de aportes</strong>
                            </div>
                            <div attrs="{'invisible': [('outstanding','&lt;','0')]}">Pagos pendientes
                                <field name="outstanding" required="0" readonly="1"/>
                            </div>
                            <div attrs="{'invisible': [('outstanding','>','0')]}">Pagos adelantados
                                <field name="outstanding" required="0" readonly="1"/>
                            </div>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" string="Nombre" attrs="{'readonly': [('state','!=','draft')]}"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="partner_name" invisible="1"/>
                                <field name="partner_status" />
                                <field name="partner_status_historical" attrs="{'invisible': [('partner_status_historical','=',False)], 'readonly': [('state','!=','draft')]}" />
                                <field name="partner_status_especific" />
                                <field name="partner_status_especific_historical" attrs="{'invisible': [('partner_status_historical','=',False)], 'readonly': [('state','!=','draft')]}" />
                                <field name="city"/>
                                <field name="partner_state"/>
                                <field name="capital_initial"/>
                                <field name="voluntary_contribution_certificate_total"/>
                                <field name="mandatory_contribution_certificate_total"/>
                                <!--                                <field name="literal_total_voluntary_contribution"/>-->
                                <field name="performance_management_total"/>
                                <field name="other_contribution_total" readonly="1"/>
                                <field name="surpluses_total" readonly="1"/>
                                <field name="amount_return" class="text-danger"/>
                                <field name="contribution_total" readonly="1"/>
                                <field name="contribution_total_excluded" readonly="1" attrs="{'invisible': [('state','!=','unassociated')]}"/>
                                <field name="date_unassociated" readonly="1" attrs="{'invisible': [('state','!=','unassociated')]}"/>
                                <h2 style="color: blue;" attrs="{'invisible': [('partner_status_especific','!=','passive_reserve_b')]}">Periodo Post mortem</h2>
                                <field name="payment_type" attrs="{'invisible': [('partner_status_especific','!=','passive_reserve_b')]}"/>
                                <field name="amount_type" attrs="{'invisible': [('partner_status_especific','!=','passive_reserve_b')]}"/>
                                <field name="since_payment" attrs="{'invisible': [('partner_status_especific','!=','passive_reserve_b')]}"/>
                                <field name="until_payment" attrs="{'invisible': [('partner_status_especific','!=','passive_reserve_b')]}"/>
                                <field name="difference_year" attrs="{'invisible': [('partner_status_especific','!=','passive_reserve_b')]}"/>
                                <field name="year_now" attrs="{'invisible': [('partner_status_especific','!=','passive_reserve_b')]}"/>
                            </group>
                            <group>
                                <field name="date_burn_partner" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="date_finalized" readonly="1"/>
                                <field name="afiliated_time"/>
                                <field name="date_registration" readonly="1"/>
                                <!--                                <field name="advanced_payments" />-->
                                <!--                                <field name="advance_mandatory_certificate" widget="integer"/>-->
                                <field name="miscellaneous_income" string="Costo afiliación pendiente"/>
                                <field name="mandatory_contribution_pending" position="attrs">
                                    <attribute name="string">Gestión:
                                        <xpath expr="//field[@name='mandatory_contribution_pending']/@string"/>
                                    </attribute>
                                </field>
                                <field name="count_mandatory_contribution_certificate"/>

                                <field name="count_pay_contributions"/>
                                <field name="mount_passive_a"/>
                                <field name="updated_partner" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Depositos">
                                <field name="payroll_payments_ids">
                                    <tree editable="bottom" default_order="date_pivote asc"
                                    class="coop_sticky_table" >
                                        <field name="currency_id" invisible="1"/>
                                        <field name="name" readonly="1" optional="hide"/>
<!--                                        <field name="partner_status_especific" invisible="1"/>-->
                                        <field name="period_register"/>
                                        <field name="income"
                                               attrs="{'readonly': [('state', '!=', 'draft')], 'column_invisible': [('parent.partner_status_especific','!=','active_service')]}"
                                               optional="hidden"
                                               sum="Total"/>
                                        <field name="income_passive"
                                               attrs="{'readonly': [('state', '!=', 'draft')], 'column_invisible': [('parent.partner_status_especific','!=','passive_reserve_b'),('parent.partner_status_especific','!=','passive_reserve_a')]}"
                                               optional="hide"
                                               sum="Total"/>
                                        <field name="miscellaneous_income"
                                               attrs="{'readonly': [('state', '!=', 'draft')]}" sum="Total"/>
                                        <field name="regulation_cup" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                               optional="hide" sum="Total"/>
                                        <field name="mandatory_contribution_certificate"
                                               attrs="{'readonly': [('state', '!=', 'draft')]}" sum="Total"/>
                                        <field name="voluntary_contribution_certificate"
                                               attrs="{'readonly': [('state', '!=', 'draft')]}" sum="Total"/>
                                        <!--                                        <field name="payment_post_mortem" attrs="{'column_invisible': [('partner_status_especific','!=','passive_reserve_b')]}"/>-->
                                        <!--                                        <field name="payment_post_mortem"-->
                                        <!--                                               attrs="{'readonly': [('state', '!=', 'draft')]}" optional="show"-->
                                        <!--                                               sum="Total"/>-->
                                        <field name="other_contribution" sum="Total"/>
                                        <field name="date_pivote" optional="hide"/>
                                        <field name="payment_date" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                               optional="show"/>
                                        <field name="register_advanced_payments_ids" optional="hide" readonly="1"/>
<!--                                        <field name="advanced_automata" optional="hide" readonly="1"/>-->
                                        <field name="state" decoration-info="state == 'contribution_interest'"
                                               decoration-success="state in ['transfer','ministry_defense']"
                                               decoration-warning="state == 'draft'"
                                               decoration-danger="state == 'no_contribution'"
                                               widget="badge"
                                               />
                                        <field name="state_account"
                                               decoration-success="state in ['posted']"
                                               decoration-warning="state == 'draft'"
                                               decoration-danger="state == 'cancel'"
                                               widget="badge"
                                                optional="hide"/>
                                        <button name="open_one2many_line" type="object" class="oe_highlight"
                                                icon="fa-eye"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Liquidacion asociado">
                                <header>
                                    <field name="state_finalize" widget="statusbar"/>
                                </header>
                                <group >
                                    <group string="Datos para la liquidacion">
                                        <field name="type_disengagements"/>
                                        <field name="date_disengagements"/>
                                        <field name="gloss_disengagement"/>
                                        <button name="process_partner_status" string="Procesar asociado" class="oe_highlight" type="object"/>
                                    </group>
                                    <group string="Categoria de asociado">
                                        <field name="partner_status_especific_reorder"/>
                                    </group>
                                </group>
<!--                                <field name="finalize_contributions_ids"/>-->
                                <field name="finalize_contributions_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="date_proccess"/>
                                        <field name="disengagement"/>
                                        <field name="total_capital_initial"/>
                                        <field name="total_mandatory_contributions"/>
                                        <field name="total_voluntary_contributions"/>
<!--                                        <field name="total_other_contributions"/>-->
<!--                                        <field name="total_surpluses"/>-->
<!--                                        <field name="total_performance_contributions"/>-->
                                        <field name="loan_capital_bolivianos"/>
                                        <field name="balance_interest_month_bolivianos"/>
                                        <button name="open_finalize_contributions" type="object" class="oe_highlight"
                                                icon="fa-eye"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Debe">
                                <field name="due_payments_ids"/>
                            </page>
                            <page string="Rendimiento">
                                <field name="performance_management_ids" editable="top"/>
                            </page>
                            <!--                            <page string="Pagos fix">-->
                            <!--                                <field name="payroll_payment_ids"/>-->
                            <!--                            </page>-->
                            <page string="Pagos adelantados">
                                <field name="advanced_payments_ids"/>
                            </page>
                            <page string="Contabilidad">
                                <group>
                                    <group>
                                        <field name="journal_id"/>
                                        <field name="account_income_id"/>
                                    </group>
                                    <group>
                                        <field name="account_inscription_id"/>
                                        <field name="account_regulation_cup_id"/>
                                        <field name="account_mandatory_contribution_id"/>
                                        <field name="account_voluntary_contribution_id"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="partner_payroll_view_search_cooperativa" model="ir.ui.view">
            <field name="name">partner_payroll.view.search.cooperativa</field>
            <field name="model">partner.payroll</field>
            <!--            <field name="inherit_id" ref="base.view_res_partner_filter"/>-->
            <field name="arch" type="xml">
                <search string="Buscar asociados">
                    <field name="code_contact"/>
                    <field name="vat" string="C.I."/>
                    <field name="partner_id"/>
<!--                    <filter name="quantity_capital_initial"-->
<!--                            string="Capital inicial"-->
<!--                            domain="[('capital_initial', '!=', 0)]"/>-->
                    <filter name="capital_initial_greater_zero"
                            string="Capital inicial mayor que '0'"
                            domain="[('capital_initial','>',0)]"/>
                    <separator />
                    <filter name="partner_active_service"
                            string="Asociados servicio activo"
                            domain="[('partner_status_especific', '=', 'active_service'),
                                    ('state','=','process')]"/>
                    <filter name="partner_passive_reserve_a"
                            string="Asociados Pasivo categoria 'A'"
                            domain="[('partner_status_especific','=','passive_reserve_a'),
                                    ('state','!=','unassociated')]"/>
                    <filter name="partner_passive_reserve_b"
                            string="Asociados Pasivo categoria 'B'"
                            domain="[('partner_status_especific','=','passive_reserve_b'),
                                    ('state','=','process')]"/>
                    <filter name="payroll_state_finalized"
                            string="Planillas Liquidadas"
                            domain="[('state', '=', 'finalized')]"/>


                    <group expand="0" string="Group By">
                        <filter string="Tipo de asociado"
                                name="group_partner_status"
                                context="{'group_by': 'partner_status_especific'}"/>
                        <filter string="Por ciudad"
                                name="group_city"
                                context="{'group_by': 'city'}"/>
                        <filter string="Por estado"
                                name="group_state"
                                context="{'group_by': 'state'}"
                        />


                    </group>
                </search>
            </field>
        </record>

        <!-- Accion para visualizar loan.application -->

        <record id="action_partner_payroll" model="ir.actions.act_window">
            <field name="name">Kardex de aportes</field>
            <field name="res_model">partner.payroll</field>
            <field name="view_mode">tree,form,pivot,graph</field>
            <field name="search_view_id" ref="partner_payroll_view_search_cooperativa"/>
            <field name="context">{
                'search_default_group_partner_status': 1
            }</field>
        </record>

        <record id="action_init_partner_payroll" model="ir.actions.server">
            <field name="name">Activar socio</field>
            <field name="model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="binding_model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="state">code</field>
            <field name="code">action = records.select_init_partner_payroll()</field>
        </record>

        <record id="action_publish_accouting_entries" model="ir.actions.server">
            <field name="name">Publicar asientos contables</field>
            <field name="model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="binding_model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="state">code</field>
            <field name="code">action = records.publish_accouting_entries()</field>
        </record>

        <record id="action_update_partner_payroll" model="ir.actions.server">
            <field name="name">Actualizar</field>
            <field name="model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="binding_model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="state">code</field>
            <field name="code">action = records.compute_updated_partner()</field>
        </record>

        <record model="ir.actions.server" id="action_report_partner_payroll">
            <field name="name">Deudas</field>
            <field name="model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="binding_model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="state">code</field>
            <field name="code">
                action = model._init_report_partner_payroll()
            </field>
        </record>
        <record model="ir.actions.server" id="action_updated_other_contribution">
            <field name="name">Otras contribuciones</field>
            <field name="model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="binding_model_id" ref="rod_cooperativa_aportes.model_partner_payroll"/>
            <field name="state">code</field>
            <field name="code">
                action = records.updated_contributions()
            </field>
        </record>

        <record id="partner_payroll_dashboard_view" model="ir.ui.view">
            <field name="name">partner.payroll.dashboard</field>
            <field name="model">partner.payroll</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard" create="0">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">Resumen de Aportes General</div>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row">
                                    <div class="col-4 o_kanban_primary_bottom" style="border-right: 1px solid #dee2e6;">
                                        <div>
                                            <strong>Socios Totales:</strong>
                                            <span class="badge badge-pill badge-info">150</span>
                                        </div>
                                        <div class="mt8">
                                            <strong>En Servicio Activo:</strong>
                                            <span class="badge badge-pill badge-success">120</span>
                                        </div>
                                    </div>

                                    <div class="col-8">
                                        <p class="text-muted text-center">Gráfico de Crecimiento de Fondos (Gestión
                                            Actual)
                                        </p>
                                        <div class="o_dashboard_graph">
                                            <field name="contribution_total" widget="dashboard_graph" graph_type="bar"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>



    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_partner_payroll" model="ir.sequence">
            <field name="name">Secuencia planilla socio</field>
            <field name="code">partner.payroll</field>
            <field name="prefix">COAAPOR</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_payroll_payments" model="ir.sequence">
            <field name="name">Secuencia pagos de socio</field>
            <field name="code">payroll.payments</field>
            <field name="prefix">BOLCOAA</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_mandatory_contribution_certificate" model="ir.sequence">
            <field name="name">Secuencia de certificados aporte obligatorio</field>
            <field name="code">payroll.payments</field>
            <field name="prefix"></field>
            <field name="padding">6</field>
        </record>
        <record id="seq_finalize_contributions" model="ir.sequence">
            <field name="name">Secuencia de liquidacion de aportes asociados</field>
            <field name="code">finalize.contributions</field>
            <field name="prefix">LIQAPOR</field>
            <field name="padding">4</field>
        </record>
        <!-- data/sequence_performance_yield_batch.xml -->
        <record id="seq_performance_yield_batch" model="ir.sequence">
            <field name="name">Lote Rendimiento</field>
            <field name="code">performance.yield.batch</field>
            <field name="prefix">RYE/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
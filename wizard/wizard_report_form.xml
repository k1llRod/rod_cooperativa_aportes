<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="wizard_report_form_id">
        <field name="name">wizard.report.form.view</field>
        <field name="model">wizard.report.form</field>
        <field name="arch" type="xml">
            <form string="Formulario de Reportes">
                <sheet>
                    <div class="oe_title">
                        <h1>Reporte de Pagos Pendientes</h1>
                    </div>

                    <group string="Filtros de Búsqueda">
                        <group>
                            <field name="partner_status_especific" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <group>
                            <field name="start_year" placeholder="Ej. 2024"/>
                            <field name="end_year" placeholder="Ej. 2026"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="report_loan_category_b"
                            string="Generar Reporte Categoría B"
                            type="object"
                            class="oe_highlight"
                            icon="fa-print"/>

                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_report_form_id" model="ir.actions.act_window">
        <field name="name">Reportes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.report.form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_report_form_id"/>
        <field name="target">new</field>
    </record>
</odoo>
<odoo>
    <data>
        <record model="ir.ui.view" id="form_finalized_contributions_id">
            <field name="name">wizard.finalized.contributions.form</field>
            <field name="model">wizard.finalized.contributions</field>
            <field name="arch" type="xml">
                <form string="Baja del asociado">
                    <group>
                        <group string="Datos de aportes">
                            <field name="partner_payroll_id" readonly="1"/>
                            <field name="date_finalize"/>
                            <field name="disengagement" />
                            <field name="regulation_cup"/>
                            <field name="total_mandatory_contributions_certificate" readonly="1"/>
                            <field name="total_voluntary_contributions_certificate" readonly="1"/>
                            <field name="capital_initial" readonly="1"/>
                            <field name="total_other_contributions" readonly="1"/>
                            <field name="total_surpluses" readonly="1"/>
                            <field name="total_performance_contributions" readonly="1"/>
                            <field name="total_contributions" readonly="1" style="font-color:red;"/>
                            <field name="partial_devolution"/>
                            <field name="option_liquidation_contributions"/>
                        </group>
                        <group string="Datos de prestamo">
                            <field name="loan_application_id" readonly="1"/>
                            <field name="default_dolar" readonly="1"/>
                            <field name="partner_name"/>
                            <field name="total_loan_capital" readonly="1"/>
                            <field name="total_loan_capital_bolivianos" readonly="1"/>
                            <field name="total_balance_total_interest_month" readonly="1"/>
                            <field name="total_balance_total_interest_month_bolivianos" readonly="1"/>
                            <field name="total"/>
                            <field name="option_liquidation"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

<!--        <record model="ir.actions.act_window" id="alert_message_action">-->
<!--            <field name="name">Alert message</field>-->
<!--            <field name="type">ir.actions.act_window</field>-->
<!--            <field name="res_model">alert.message</field>-->
<!--            <field name="view_mode">form</field>-->
<!--            <field name="view_id" ref="alert_message_form_view" />-->
<!--            <field name="target">new</field>-->
<!--        </record>-->
    </data>
</odoo>

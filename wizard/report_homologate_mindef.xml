<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Formulario del Wizard -->
    <record id="view_mindef_report_wizard_form" model="ir.ui.view">
        <field name="name">mindef.report.wizard.form</field>
        <field name="model">mindef.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Resumen de Homologación">
                <group>
                    <field name="month"/>
                    <field name="year"/>
                </group>
                <group>
                    <field name="draft_quantity"/>
                    <field name="no_reconciled_quantity"/>
                    <field name="reconciled_quantity"/>
                    <field name="observed_quantity"/>
                </group>
                <footer>
                    <button name="action_generate_summary" string="Procesar Resumen" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mindef_payment_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte Mensual Aportes Mindef</field>
        <field name="res_model">mindef.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_mindef_payment_reports_category"
              name="Reportes MINDEF"
              parent="rod_cooperativa_aportes.menu_root"
              sequence="4"/>

    <menuitem id="menu_mindef_payment_report"
              name="Reporte Mensual Aportes"
              parent="menu_mindef_payment_reports_category"
              action="action_mindef_payment_report_wizard"
              sequence="1"/>

</odoo>
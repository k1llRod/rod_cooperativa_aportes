<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="rod_layout_liquidation">
            <div class="header">
                <div class="row">
                    <table style="width:100%;">
                        <tr>
                            <td style="width:20%;" rowspan="6">
                                <img t-att-src="'/rod_account_coa/static/src/img/coaa.png'" style="width:120px;"/>
                            </td>
                            <td style="width:60%;">
                                <center>COOPERATIVA DE AHORRO Y CREDITO DE VINCULO LABORAL</center>
                            </td>
                            <td style="width:20%;">
                                <strong style="padding-left:15px;">Usuario:</strong>
                                <t t-esc="user.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <center>"COA-4 DE DICIEMBRE" R.L.</center>
                            </td>
                            <td>
                                <strong style="padding-left:15px;">Fecha:</strong>
                                <t t-esc="datetime.date.today().strftime('%d-%m-%Y')"/>
                            </td>
                        </tr>
                        <tr>

                            <td>
                                <center>Mezzanine Of. 09 - Telf./Fax: 2420530</center>
                            </td>

                        </tr>
                        <tr>

                            <td>
                                <center>Av. Ecuador N 738</center>
                            </td>

                        </tr>
                        <tr>

                            <td>
                                <center>La Paz - Bolivia</center>
                            </td>

                        </tr>
                        <tr>
                            <td></td>
                        </tr>

                    </table>

                </div>
            </div>
            <div class="article o_report_layout_standard">
                <t t-out="0"/>
            </div>
            <div class="footer o_standard_footer">
                <div class="row">

                </div>
            </div>
        </template>
        <template id="report_liquidation_partner">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="page body">
                        <t t-call="rod_cooperativa_aportes.rod_layout_liquidation">
                            <div>
                                <center>
                                    <h3>No. /2024</h3>
                                </center>
                                <center>
                                    <h3>DEVOLUCION DE CERTIFICACION DE</h3>
                                </center>
                                <center>
                                    <h3>APORTACIONES Y EXCEDENTES</h3>
                                </center>
                                <p>
                                    Devolucion de Certificacion de APORTACIONES y EXCEDENTES de Percepcion señor(a)
                                    <strong>
                                        <span t-field="o.partner_id.category_partner_id.code_loan"/>
                                        <span t-field="o.partner_id.weapon"/>
                                        <span t-field="o.partner_id.name"/>
                                    </strong>
                                    Asociado(a) de la <strong>COOPERATIVA DE AHORRO Y CREDITO DE VINCULO LABORAL "COA -
                                    4 DE DICIEMBRE" R.L.
                                </strong> de acuerdo al siguiente detalle:
                                </p>
                            </div>
                            <div>
                                <t t-foreach="o.finalize_contributions_ids" t-as="l">
                                    <table class="table table-bordered">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <strong>
                                                        <u>CERTIFICACION DE APORTES OBLIGATORIOS</u>
                                                    </strong>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    CERTIFICACION DE APORTACION
                                                </td>
                                                <td>
                                                    Bs.
                                                </td>
                                                <td>
                                                    <span t-esc="round((l.total_mandatory_contributions), 2)"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <strong>
                                                        <u>CERTIFICACION DE APORTES VOLUNTARIOS</u>
                                                    </strong>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    APORTES
                                                </td>
                                                <td>
                                                    Bs.
                                                </td>
                                                <td>
                                                    <span t-esc="round((l.total_voluntary_contributions) + (l.total_capital_initial), 2)"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <strong>
                                                        <u>OTROS APORTES</u>
                                                    </strong>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    APORTES
                                                </td>
                                                <td>
                                                    Bs.
                                                </td>
                                                <td>
                                                    <span t-esc="round((l.other_contributions), 2)"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <strong>
                                                        <u>EXCEDENTE DE PERCEPCION</u>
                                                    </strong>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    EXCEDENTES
                                                </td>
                                                <td>
                                                    Bs.
                                                </td>
                                                <td>
                                                    <span t-esc="round((l.surpluses), 2)"/>
                                                </td>
                                            </tr>
                                            <tr style="font-weight:bold;">
                                                <td>
                                                    TOTAL APORTACIONES Y EXCEDENTES
                                                </td>
                                                <td>
                                                    Bs.
                                                </td>
                                                <td>
                                                    <span t-esc="round((l.total_amount), 2)"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <hr/>
                                <h4>
                                    <u>DESCUENTOS</u>
                                </h4>
                                <table class="table table-bordered">
                                    <tbody>
                                        <tr>
                                            <td>
                                                PRESTAMO
                                            </td>
                                            <td>
                                                Bs.
                                            </td>
                                            <td>
                                                <span t-esc="round(l.loan_capital_bolivianos, 2)"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                DIAS EXCEDENTES
                                            </td>
                                            <td>
                                                Bs.
                                            </td>
                                            <td>
                                                <span t-esc="round(l.balance_interest_month_bolivianos, 2)"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                DESVICULACION COOP.
                                            </td>
                                            <td>
                                                Bs.
                                            </td>
                                            <td>
                                                <span t-esc="round((l.disengagement), 2) * (-1)"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight:bold;">
                                                TOTAL DESCUENTOS
                                            </td>
                                            <td style="font-weight:bold;">
                                                Bs.
                                            </td>
                                            <td style="font-weight:bold;">
                                                <span t-esc="round(l.loan_capital_bolivianos + l.balance_interest_month_bolivianos - l.disengagement, 2)"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight:bold;">
                                                TOTAL DEVOLUCION
                                            </td>
                                            <td style="font-weight:bold;">
                                                Bs.
                                            </td>
                                            <td style="font-weight:bold;">
                                                <span t-esc="round(l.rest_contributions, 2)"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="oe_structure"/>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>

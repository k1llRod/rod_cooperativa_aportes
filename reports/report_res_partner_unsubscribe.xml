<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_res_partner_unsubscribe_template">
            <t t-call="web.html_container">
                <t t-set="report_title">Reporte de Socios Dados de Baja</t>
                <div class="page">
                    <h2 t-esc="report_title"/>
                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th>FECHA DE BAJA</th>
                                <th>NOMBRE COMPLETO</th>
                                <th>CI/NIT</th>
                                <th>DIRECCIÓN</th>
                                <th>BAJA POR</th>
                                <th>GLOSA</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="partner">
                                <tr>
                                    <td>
                                        <span t-esc="partner.date_disengagements"/>
                                    </td>
                                    <td>
                                        <span t-esc="partner.name"/>
                                    </td>
                                    <td>
                                        <span t-esc="partner.vat"/>
                                    </td>
                                    <td>
                                        <span t-esc="partner.street"/>
                                    </td>
                                    <td>
                                        <span t-esc="partner.type_disengagements"/>
                                    </td>
                                    <td>
                                        <span t-esc="partner.gloss_disengagement"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>
    </data>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_res_partner_unsubscribe_template">
            <t t-call="web.html_container">
                <t t-set="report_title">Reporte de Socios Dados de Baja</t>
                <div class="page" style="font-family: 'Arial', sans-serif; font-size: 18px;">
                    <div class="header"
                         style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <h2 style="margin: 0;" t-esc="report_title"/>
                                <!--                            <p style="margin: 0;">Fecha de impresión: <span t-esc="format_date(datetime.now())"/></p>-->
                            </div>
                            <div>
                                <!--                            <img t-att-src="'/web/image/res.company/%s/logo' % company.id"-->
                                <!--                                 style="max-height: 60px;" alt="Logo"/>-->
                            </div>
                        </div>
                    </div>
                    <div class="body">
                        <table class="table table-sm table-bordered"
                               style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
                            <thead style="background-color: #f0f0f0;">
                                <tr style="border: 1px solid #000;">
                                    <th style="padding: 8px; border: 1px solid #000;">FECHA DE BAJA</th>
                                    <th style="padding: 8px; border: 1px solid #000;">NOMBRE COMPLETO</th>
                                    <th style="padding: 8px; border: 1px solid #000;">CI/NIT</th>
                                    <th style="padding: 8px; border: 1px solid #000;">DIRECCIÓN</th>
                                    <th style="padding: 8px; border: 1px solid #000;">BAJA POR</th>
                                    <th style="padding: 8px; border: 1px solid #000;">GLOSA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="partner">
                                    <tr style="border: 1px solid #000;">
                                        <td style="padding: 6px; border: 1px solid #000;">
                                            <span t-esc="partner.date_disengagements"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #000;">
                                            <span t-esc="partner.name"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #000;">
                                            <span t-esc="partner.vat"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #000;">
                                            <span t-esc="partner.street"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #000;">
                                            <span t-esc="partner.type_disengagements"/>
                                        </td>
                                        <td style="padding: 6px; border: 1px solid #000;">
                                            <span t-esc="partner.gloss_disengagement"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="footer text-center" style="border-top: 1px solid #000; padding-top: 10px;">
                        <p style="font-size: 10px; color: #666;">Este reporte fue generado automáticamente por el
                            sistema de gestión. Todos los derechos reservados.
                        </p>
                    </div>
                </div>
            </t>
        </template>
    </data>

</odoo>
